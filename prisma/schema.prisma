// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles utilisateur
enum UserRole {
  USER
  ESTABLISHMENT
  ADMIN
}

// Types d'activités - gérés dynamiquement via la table ActivityTypeConfig
// (Ancien enum supprimé au profit d'un champ String + table de référence)

// Statut d'activité
enum ActivityStatus {
  DRAFT
  PUBLISHED
}

// Type de média
enum MediaKind {
  IMAGE
  VIDEO        // Lien externe (YouTube, Vimeo, etc.)
  VIDEO_UPLOAD // Fichier vidéo uploadé
}

// Statut d'abonnement
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

// Type d'événement analytics
enum StatEventType {
  IMPRESSION
  CLICK
}

// Modèle User (utilisateur, établissement ou admin)
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  name                   String?
  role                   UserRole  @default(USER)
  isActive               Boolean   @default(true)
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?   @unique
  emailVerificationExpires DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  establishment Establishment?
  favorites     Favorite[]
}

// Modèle Établissement
model Establishment {
  id         String   @id @default(cuid())
  userId     String   @unique
  name       String
  phone      String?
  website    String?
  bookingUrl String?  // Lien de réservation externe (Calendly, etc.)
  address    String?
  city       String?
  zipCode    String?
  country    String   @default("France")
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Stripe - Abonnement
  stripeCustomerId       String?             @unique
  stripeSubscriptionId   String?             @unique
  subscriptionStatus     SubscriptionStatus?
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?

  // Code promo utilisé
  usedPromoCodeId        String?

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity?   // Relation 1:1 - un établissement = une activité
  usedPromoCode PromoCode? @relation(fields: [usedPromoCodeId], references: [id])
}

// Modèle Activité (unique par établissement)
model Activity {
  id              String         @id @default(cuid())
  establishmentId String         @unique // Contrainte 1:1
  type            String         // Slug du type d'activité (ex: "BOWLING", "ROLLER_CLUB")
  title           String
  description     String         @db.Text
  address         String
  city            String
  zipCode         String
  country         String         @default("France")
  lat             Float
  lng             Float
  minPeople       Int?
  maxPeople       Int?
  durationMinutes Int?
  priceFrom       Float?
  scheduleText    String?        @db.Text
  tags            String[]
  coverMediaId    String?        // ID du média choisi comme couverture
  zone1Tags       String[]       // Mood social: en-couple, en-famille, entre-amis, en-solo
  zone2Tags       String[]       // Ambiance/format: detente-chill, immersif, ludique, after-work, soiree
  zone3Tags       String[]       // Profil d'intérêt: sportif, creatifs, gourmands, culture
  adminPick       Boolean        @default(false) // Validé/mis en avant par un admin Wadelo
  status          ActivityStatus @default(DRAFT)
  viewCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  medias        Media[]
  favorites     Favorite[]
  statEvents    ActivityStatEvent[]
  events        Event[]

  @@index([status])
  @@index([type])
  @@index([city])
  @@index([lat, lng])
}

// Modèle Média
model Media {
  id                 String    @id @default(cuid())
  activityId         String
  kind               MediaKind
  url                String
  fileName           String?   // Nom du fichier original (pour vidéos uploadées)
  fileSize           Int?      // Taille en bytes (pour vidéos uploadées)
  videoCategory      String?   // Catégorie vidéo : "teaser", "ambiance", "cours", etc.
  title              String?   // Titre optionnel du média
  thumbnailUrl       String?   // URL de la vignette (pour vidéos)
  duration           Int?      // Durée en secondes (pour vidéos)
  cloudflareImageId  String?   // ID Cloudflare Images (pour images hébergées sur CF)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, kind])
}

// Modèle Favoris
model Favorite {
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
}

// Modèle Événement Analytics (impressions et clics)
model ActivityStatEvent {
  id         String        @id @default(cuid())
  activityId String
  type       StatEventType
  sessionId  String?       // Cookie de session anonyme
  userId     String?       // Si utilisateur connecté
  createdAt  DateTime      @default(now())

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, type, createdAt])
  @@index([activityId, sessionId, createdAt])
}

// Modèle Code Promo
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  extraTrialDays  Int       @default(0)  // Jours de trial supplémentaires
  maxRedemptions  Int?                   // Limite d'utilisations (null = illimité)
  redeemedCount   Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  establishments Establishment[]
}

// Modèle Paramètres du site (singleton)
model SiteSettings {
  id                    String   @id @default("default")
  // Vidéo de fond (prioritaire si définie)
  heroVideoDesktopUrl   String?  // Vidéo de fond desktop
  heroVideoMobileUrl    String?  // Vidéo de fond mobile
  heroVideoDesktopName  String?  // Nom du fichier vidéo desktop
  heroVideoMobileName   String?  // Nom du fichier vidéo mobile
  // Image de fond (fallback si pas de vidéo)
  heroImageDesktopUrl   String?  // Image de fond desktop
  heroImageMobileUrl    String?  // Image de fond mobile
  heroImageDesktopName  String?  // Nom du fichier image desktop
  heroImageMobileName   String?  // Nom du fichier image mobile
  updatedAt             DateTime @updatedAt
}

// Modèle Événement (calendrier par activité)
model Event {
  id          String   @id @default(cuid())
  activityId  String
  title       String
  description String?  @db.Text
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, startAt])
  @@index([startAt])
}

// Configuration des types d'activités (géré par l'admin)
model ActivityTypeConfig {
  id        String   @id @default(cuid())
  slug      String   @unique  // Identifiant unique (ex: "BOWLING", "ROLLER_CLUB")
  label     String            // Nom affiché (ex: "Bowling", "Club de roller")
  emoji     String   @default("🎯") // Emoji ou icône (fallback si pas d'iconUrl)
  iconUrl   String?           // URL de l'icône uploadée (png/svg)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pages statiques / légales (géré par l'admin)
model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique  // Ex: "mentions-legales", "cgu", "cgv", etc.
  title     String             // Titre affiché
  content   String   @default("") @db.Text  // Contenu en markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuration des catégories de vidéos (géré par l'admin)
model VideoCategoryConfig {
  id        String   @id @default(cuid())
  slug      String   @unique  // Identifiant unique (ex: "teaser", "ambiance")
  label     String            // Nom affiché (ex: "Teaser", "Ambiance")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
