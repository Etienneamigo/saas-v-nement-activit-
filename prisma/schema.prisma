// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles utilisateur
enum UserRole {
  USER
  ESTABLISHMENT
  ADMIN
}

// Types d'activités - gérés dynamiquement via la table ActivityTypeConfig
// (Ancien enum supprimé au profit d'un champ String + table de référence)

// Statut de demande de vérification
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Statut d'activité
enum ActivityStatus {
  DRAFT
  PUBLISHED
}

// Type de média
enum MediaKind {
  IMAGE
  VIDEO        // Lien externe (YouTube, Vimeo, etc.)
  VIDEO_UPLOAD // Fichier vidéo uploadé
}

// Statut d'abonnement
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

// Type d'événement analytics
enum StatEventType {
  IMPRESSION
  CLICK
}

// Modèle User (utilisateur, établissement ou admin)
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  name                   String?
  role                   UserRole  @default(USER)
  isActive               Boolean   @default(true)
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?   @unique
  emailVerificationExpires DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  establishment       Establishment?
  favorites           Favorite[]
  reservations        Reservation[]
  passwordResetTokens PasswordResetToken[]
}

// Token de réinitialisation de mot de passe
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Modèle Établissement
model Establishment {
  id         String   @id @default(cuid())
  userId     String   @unique
  name       String
  phone      String?
  website    String?
  bookingUrl String?  // Lien de réservation externe (Calendly, etc.)
  address    String?
  city       String?
  zipCode    String?
  country    String   @default("France")
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Stripe - Abonnement
  stripeCustomerId       String?             @unique
  stripeSubscriptionId   String?             @unique
  subscriptionStatus     SubscriptionStatus?
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?

  // Code promo utilisé
  usedPromoCodeId        String?

  // Vérification établissement
  verifiedAt             DateTime?
  verifiedByAdminId      String?

  // Accessibilité (PMR et autres)
  accessWheelchair       Boolean  @default(false)  // Accès fauteuil roulant (PMR)
  accessToilets          Boolean  @default(false)  // Toilettes accessibles PMR
  accessParking          Boolean  @default(false)  // Parking PMR
  accessElevator         Boolean  @default(false)  // Ascenseur disponible
  accessLevelEntry       Boolean  @default(false)  // Accès plain-pied (sans marches)

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity?   // Relation 1:1 - un établissement = une activité
  usedPromoCode PromoCode? @relation(fields: [usedPromoCodeId], references: [id])
  verificationRequests VerificationRequest[]
  reservationSettings  ReservationSettings?
  reservations         Reservation[]
  reservationOverrides ReservationOverride[]
  reservationResources ReservationResource[]
  reservationSlots     ReservationSlot[]
}

// Modèle Activité (unique par établissement)
model Activity {
  id              String         @id @default(cuid())
  establishmentId String         @unique // Contrainte 1:1
  type            String         // Slug du type d'activité (ex: "BOWLING", "ROLLER_CLUB")
  title           String
  description     String         @db.Text
  address         String
  city            String
  zipCode         String
  country         String         @default("France")
  lat             Float
  lng             Float
  minPeople       Int?
  maxPeople       Int?
  durationMinutes Int?
  priceFrom       Float?
  scheduleText    String?        @db.Text
  tags            String[]
  coverMediaId    String?        // ID du média choisi comme couverture
  zone1Tags       String[]       // Mood social: en-couple, en-famille, entre-amis, en-solo
  zone2Tags       String[]       // Ambiance/format: detente-chill, immersif, ludique, after-work, soiree
  zone3Tags       String[]       // Profil d'intérêt: sportif, creatifs, gourmands, culture
  adminPick       Boolean        @default(false) // Validé/mis en avant par un admin Wadelo
  status          ActivityStatus @default(DRAFT)
  viewCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  medias        Media[]
  favorites     Favorite[]
  statEvents    ActivityStatEvent[]
  events        Event[]

  @@index([status])
  @@index([type])
  @@index([city])
  @@index([lat, lng])
}

// Modèle Média
model Media {
  id                 String    @id @default(cuid())
  activityId         String
  kind               MediaKind
  url                String
  fileName           String?   // Nom du fichier original (pour vidéos uploadées)
  fileSize           Int?      // Taille en bytes (pour vidéos uploadées)
  videoCategory      String?   // Catégorie vidéo : "teaser", "ambiance", "cours", etc.
  title              String?   // Titre optionnel du média
  thumbnailUrl       String?   // URL de la vignette (pour vidéos)
  duration           Int?      // Durée en secondes (pour vidéos)
  cloudflareImageId  String?   // ID Cloudflare Images (pour images hébergées sur CF)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, kind])
}

// Modèle Favoris
model Favorite {
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
}

// Modèle Événement Analytics (impressions et clics)
model ActivityStatEvent {
  id         String        @id @default(cuid())
  activityId String
  type       StatEventType
  sessionId  String?       // Cookie de session anonyme
  userId     String?       // Si utilisateur connecté
  createdAt  DateTime      @default(now())

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, type, createdAt])
  @@index([activityId, sessionId, createdAt])
}

// Modèle Code Promo
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  extraTrialDays  Int       @default(0)  // Jours de trial supplémentaires
  maxRedemptions  Int?                   // Limite d'utilisations (null = illimité)
  redeemedCount   Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  establishments Establishment[]
}

// Modèle Paramètres du site (singleton)
model SiteSettings {
  id                    String   @id @default("default")
  // Vidéo de fond (prioritaire si définie)
  heroVideoDesktopUrl   String?  // Vidéo de fond desktop
  heroVideoMobileUrl    String?  // Vidéo de fond mobile
  heroVideoDesktopName  String?  // Nom du fichier vidéo desktop
  heroVideoMobileName   String?  // Nom du fichier vidéo mobile
  // Image de fond (fallback si pas de vidéo)
  heroImageDesktopUrl   String?  // Image de fond desktop
  heroImageMobileUrl    String?  // Image de fond mobile
  heroImageDesktopName  String?  // Nom du fichier image desktop
  heroImageMobileName   String?  // Nom du fichier image mobile
  updatedAt             DateTime @updatedAt
}

// Modèle Événement (calendrier par activité)
model Event {
  id          String   @id @default(cuid())
  activityId  String
  title       String
  description String?  @db.Text
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, startAt])
  @@index([startAt])
}

// Configuration des types d'activités (géré par l'admin)
model ActivityTypeConfig {
  id        String   @id @default(cuid())
  slug      String   @unique  // Identifiant unique (ex: "BOWLING", "ROLLER_CLUB")
  label     String            // Nom affiché (ex: "Bowling", "Club de roller")
  emoji     String   @default("🎯") // Emoji ou icône (fallback si pas d'iconUrl)
  iconUrl   String?           // URL de l'icône uploadée (png/svg)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pages statiques / légales (géré par l'admin)
model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique  // Ex: "mentions-legales", "cgu", "cgv", etc.
  title     String             // Titre affiché
  content   String   @default("") @db.Text  // Contenu en markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuration des catégories de vidéos (géré par l'admin)
model VideoCategoryConfig {
  id        String   @id @default(cuid())
  slug      String   @unique  // Identifiant unique (ex: "teaser", "ambiance")
  label     String            // Nom affiché (ex: "Teaser", "Ambiance")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Réservation Native ───────────────────────────────────────────────────────

// Statut de réservation
enum ReservationStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
}

// Type de champ personnalisé
enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  PHONE
  EMAIL
  CHECKBOX
}

// Paramètres de réservation native par établissement
model ReservationSettings {
  id                       String   @id @default(cuid())
  establishmentId          String   @unique
  enabled                  Boolean  @default(false)
  showExternalLinkAlso     Boolean  @default(false)
  timezone                 String   @default("Europe/Paris")
  slotDurationMinutes      Int      @default(60)
  capacityPerSlot          Int      @default(10)
  minPartySize             Int      @default(1)
  maxPartySize             Int      @default(10)
  minNoticeMinutes         Int      @default(120)   // Délai minimum avant réservation
  bookingWindowDays        Int      @default(30)    // Fenêtre de réservation J+n
  cancellationEnabled      Boolean  @default(true)
  cancellationDeadlineHours Int     @default(24)
  confirmationMessage      String?  @db.Text
  cancellationPolicyText   String?  @db.Text
  resourceSelectionMode    ResourceSelectionMode @default(HIDDEN)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  establishment      Establishment                   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  weeklySchedule     WeeklySchedule[]
  customFieldDefs    ReservationCustomFieldDef[]
  reservations       Reservation[]
}

// Horaires hebdomadaires (un enregistrement par jour actif)
model WeeklySchedule {
  id         String   @id @default(cuid())
  settingsId String
  dayOfWeek  Int      // 0=Dimanche … 6=Samedi
  openRanges Json     // [{start:"HH:mm", end:"HH:mm"}]

  settings ReservationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, dayOfWeek])
  @@index([settingsId])
}

// Exceptions par date (fermetures ou horaires custom)
model ReservationOverride {
  id               String   @id @default(cuid())
  establishmentId  String
  date             DateTime @db.Date
  isClosed         Boolean  @default(false)
  customOpenRanges Json?    // [{start:"HH:mm", end:"HH:mm"}] si override horaires
  customCapacity   Int?     // Capacité spéciale pour ce jour

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, date])
  @@index([establishmentId, date])
}

// Réservation client
model Reservation {
  id              String            @id @default(cuid())
  settingsId      String
  establishmentId String
  userId          String?
  slotId          String?           // FK ReservationSlot (si slots persistés)
  resourceId      String?           // FK ReservationResource (si multi-salles)
  startAt         DateTime
  endAt           DateTime
  partySize       Int
  status          ReservationStatus @default(CONFIRMED)
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  settings      ReservationSettings         @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  establishment Establishment               @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  slot          ReservationSlot?            @relation(fields: [slotId], references: [id], onDelete: SetNull)
  resource      ReservationResource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  customValues  ReservationCustomFieldValue[]

  @@index([establishmentId, startAt])
  @@index([establishmentId, status])
  @@index([userId])
  @@index([slotId])
}

// Définitions de champs personnalisés par établissement
model ReservationCustomFieldDef {
  id              String          @id @default(cuid())
  settingsId      String
  label           String
  type            CustomFieldType @default(TEXT)
  required        Boolean         @default(false)
  optionsJson     Json?           // Pour SELECT : ["option1","option2"]
  order           Int             @default(0)
  createdAt       DateTime        @default(now())

  settings ReservationSettings         @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  values   ReservationCustomFieldValue[]

  @@index([settingsId])
}

// Valeurs saisies par le client pour une réservation
model ReservationCustomFieldValue {
  id              String @id @default(cuid())
  reservationId   String
  fieldDefId      String
  value           String @db.Text

  reservation Reservation               @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fieldDef    ReservationCustomFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)

  @@unique([reservationId, fieldDefId])
}

// Ressource réservable (ex: salle d'escape game, piste, terrain…)
model ReservationResource {
  id              String   @id @default(cuid())
  establishmentId String
  name            String   // ex: "Salle A", "Piste 3", "Terrain B"
  capacity        Int
  isActive        Boolean  @default(true)
  description     String?  @db.Text
  imageUrl        String?  @db.Text
  useCustomRules  Boolean  @default(false)   // false = hérite des paramètres globaux
  minPartySizeOverride       Int?   // Override minPartySize (null = hérite)
  maxPartySizeOverride       Int?   // Override maxPartySize
  slotDurationMinutesOverride Int?  // Override slotDurationMinutes
  bookingWindowDaysOverride   Int?  // Override bookingWindowDays
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  slots         ReservationSlot[]
  reservations  Reservation[]

  @@index([establishmentId])
}

// Source d'un créneau persisté
enum SlotSource {
  AUTO   // Généré depuis WeeklySchedule
  MANUAL // Créé manuellement par l'établissement
}

// Mode de sélection de salle côté client
enum ResourceSelectionMode {
  HIDDEN             // Client ne voit pas les salles ; auto-assign côté backend
  PICK_RESOURCE_FIRST // Client choisit une salle, puis voit ses disponibilités
  PICK_TIME_FIRST     // Client choisit un créneau, puis choisit parmi les salles dispo
}

// Créneau persisté (éditable par l'établissement)
model ReservationSlot {
  id              String     @id @default(cuid())
  establishmentId String
  startAt         DateTime
  endAt           DateTime
  capacity        Int
  isActive        Boolean    @default(true)
  resourceId      String?    // nullable → salle spécifique
  source          SlotSource @default(AUTO)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  resource      ReservationResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  reservations  Reservation[]

  @@index([establishmentId, startAt])
  @@index([resourceId, startAt])
}

// ─── Fin Réservation Native ───────────────────────────────────────────────────

// Demande de vérification d'un établissement
model VerificationRequest {
  id              String             @id @default(cuid())
  establishmentId String
  status          VerificationStatus @default(PENDING)
  message         String?            @db.Text  // Message optionnel de l'établissement
  adminNote       String?            @db.Text  // Note interne de l'admin (raison refus, etc.)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  attachments   VerificationAttachment[]

  @@index([establishmentId])
  @@index([status])
}

// Pièce jointe d'une demande de vérification (KBIS, etc.)
model VerificationAttachment {
  id                    String   @id @default(cuid())
  verificationRequestId String
  fileName              String   // Nom original du fichier
  storagePath           String   // Chemin privé sur le serveur (hors /public)
  fileSize              Int      // Taille en bytes
  mimeType              String   // Type MIME (application/pdf, image/jpeg, etc.)
  createdAt             DateTime @default(now())

  // Relations
  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
}
